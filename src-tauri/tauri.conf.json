{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoLive",
  "version": "0.1.0",
  "identifier": "com.golive.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GoLive",
        "width": 900,
        "height": 640,
        "minWidth": 760,
        "minHeight": 480
      },
      {
        "label": "widget",
        "title": "GoLive Capture",
        "url": "widget.html",
        "width": 260,
        "height": 210,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "skipTaskbar": true,
        "shadow": true,
        "visible": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
